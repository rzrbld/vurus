find_program(VYRUZ_CARGO cargo HINTS "$ENV{HOME}/.cargo/bin" REQUIRED)
set(VYRUZ_RUST_TARGET "" CACHE STRING "Rust target triple (required when cross compiling)")
if(CMAKE_CROSSCOMPILING AND NOT VYRUZ_RUST_TARGET)
  message(FATAL_ERROR "Cross compiling requires VYRUZ_RUST_TARGET and a configured Cargo linker for that target")
endif()
set(_indeo_target_args)
set(_indeo_target_path "")
if(VYRUZ_RUST_TARGET)
  list(APPEND _indeo_target_args --target "${VYRUZ_RUST_TARGET}")
  set(_indeo_target_path "${VYRUZ_RUST_TARGET}/")
endif()
if(MSVC)
  set(_indeo_name vyruz_indeo.lib)
  # The default MSVC runtime is /MD, matching Rust's default crt-static=false.
  set(_indeo_system ws2_32 userenv bcrypt ntdll kernel32 advapi32 synchronization)
else()
  set(_indeo_name libvyruz_indeo.a)
  if(APPLE)
    set(_indeo_system resolv iconv)
  else()
    set(_indeo_system dl pthread m)
  endif()
endif()
if(WIN32 AND NOT MSVC)
  message(FATAL_ERROR "Windows currently requires MSVC and Rust windows-msvc; MinGW is not a validated build configuration")
endif()
set(INDEO_LIB "${CMAKE_CURRENT_BINARY_DIR}/indeo/${_indeo_target_path}release/${_indeo_name}")
file(GLOB_RECURSE INDEO_SOURCES CONFIGURE_DEPENDS "third_party/oxideav-indeo/src/*.rs" "src/video/indeo_bridge/*.rs")
add_custom_command(OUTPUT "${INDEO_LIB}"
 COMMAND "${VYRUZ_CARGO}" build --manifest-path "${CMAKE_CURRENT_SOURCE_DIR}/src/video/indeo_bridge/Cargo.toml" --release --offline --locked --target-dir "${CMAKE_CURRENT_BINARY_DIR}/indeo" ${_indeo_target_args}
 DEPENDS ${INDEO_SOURCES} src/video/indeo_bridge/Cargo.toml src/video/indeo_bridge/Cargo.lock VERBATIM)
add_custom_target(indeo_build DEPENDS "${INDEO_LIB}")
add_library(indeo STATIC IMPORTED)
set_target_properties(indeo PROPERTIES IMPORTED_LOCATION "${INDEO_LIB}" INTERFACE_LINK_LIBRARIES "${_indeo_system}")
add_dependencies(indeo indeo_build)
