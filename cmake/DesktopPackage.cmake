# A portable directory, not a system installer: data/settings stay beside vurus.
if(WIN32 OR APPLE)
  install(TARGETS vurus RUNTIME DESTINATION .)
  install(FILES "${CMAKE_SOURCE_DIR}/LICENSE" "${CMAKE_SOURCE_DIR}/LICENSE.md" DESTINATION .)
  install(FILES "${CMAKE_SOURCE_DIR}/third_party/oxideav-indeo/LICENSE" DESTINATION LICENSES/oxideav-indeo)
  install(DIRECTORY "${CMAKE_SOURCE_DIR}/third_party/oxideav-indeo/rust-licenses" DESTINATION LICENSES/oxideav-indeo)
  install(FILES "${CMAKE_SOURCE_DIR}/third_party/zlib/LICENSE" DESTINATION LICENSES RENAME zlib.txt)
  install(FILES "${CMAKE_SOURCE_DIR}/packaging/README-desktop.txt" DESTINATION . RENAME README.txt)
  install(FILES "${CMAKE_SOURCE_DIR}/third_party/smaa/LICENSE.txt" DESTINATION LICENSES RENAME SMAA.txt)
  install(FILES "${CMAKE_SOURCE_DIR}/third_party/mame-psgs/LICENSE" DESTINATION LICENSES RENAME MAME-PSGS.txt)
  install(FILES "${CMAKE_SOURCE_DIR}/third_party/mame-psgs/NOTICE" DESTINATION LICENSES RENAME MAME-PSGS-NOTICE.txt)
  if(VYRUZ_SDL_SOURCE)
    install(FILES "${VYRUZ_SDL_SOURCE}/LICENSE.txt" DESTINATION LICENSES RENAME SDL2.txt)
  else()
    message(WARNING "Desktop packages require static SDL2 or separately bundled SDL2 runtime. CI uses VYRUZ_SDL_SOURCE.")
  endif()
  if(MSVC)
    # Bundle the redistributable runtime; users need not install Visual Studio.
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION .)
    include(InstallRequiredSystemLibraries)
  endif()
  set(CPACK_PACKAGE_NAME vurus)
  set(CPACK_PACKAGE_VERSION "0.1.0")
  string(TOLOWER "${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}" _package_platform)
  set(CPACK_PACKAGE_FILE_NAME "vurus-${_package_platform}")
  set(CPACK_GENERATOR ZIP)
  include(CPack)
else()
  install(TARGETS vurus RUNTIME DESTINATION bin)
endif()
