# Native host builds; retain the existing Linux dependency discovery by default.
set(VYRUZ_SDL_SOURCE "" CACHE PATH "Optional SDL2 source tree to build statically")
if(APPLE)
  set(_smaa_default OFF)
  add_compile_definitions(GL_SILENCE_DEPRECATION)
  # Preserve explicit multiply/add rounding in native-mechanics helpers.
  add_compile_options(-ffp-contract=off)
else()
  set(_smaa_default ON)
endif()
option(VYRUZ_ENABLE_SMAA "Build SMAA (requires desktop compatibility OpenGL 3.0)" ${_smaa_default})
if(APPLE AND VYRUZ_ENABLE_SMAA)
  message(FATAL_ERROR "SMAA requires GL3 compatibility, unavailable on macOS. Use -DVYRUZ_ENABLE_SMAA=OFF; FXAA remains supported.")
endif()
add_compile_definitions(VYRUZ_ENABLE_SMAA=$<BOOL:${VYRUZ_ENABLE_SMAA}>)
if(WIN32)
  add_compile_definitions(NOMINMAX WIN32_LEAN_AND_MEAN SDL_MAIN_HANDLED)
endif()
if(MSVC)
  add_compile_options(/utf-8 /bigobj /permissive- /fp:strict)
endif()
