if(NOT EXISTS "${BINARY}")
  message(FATAL_ERROR "Missing binary for glibc requirement check: ${BINARY}")
endif()
execute_process(COMMAND "${READELF}" --version-info "${BINARY}"
                RESULT_VARIABLE result OUTPUT_VARIABLE versions ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect runtime requirements: ${error}")
endif()
string(REGEX MATCHALL "Name: GLIBC_[0-9]+(\\.[0-9]+)+" requirements "${versions}")
if(NOT requirements)
  message(FATAL_ERROR "No glibc versions found; cannot validate this compatibility build")
endif()
set(highest "0")
foreach(requirement IN LISTS requirements)
  string(REPLACE "Name: GLIBC_" "" version "${requirement}")
  if(version VERSION_GREATER highest)
    set(highest "${version}")
  endif()
  if(version VERSION_GREATER MAX_GLIBC)
    message(FATAL_ERROR "${BINARY} requires glibc ${version}, newer than the ${MAX_GLIBC} target. Rebuild with a compatible toolchain.")
  endif()
endforeach()
message(STATUS "${BINARY}: highest direct glibc requirement ${highest} (limit ${MAX_GLIBC}); target-system libraries still require device validation")
